{
  "apiVersion": "1.0",
  "swaggerVersion": "1.2",
  "basePath": "",
  "resourcePath": "user_activities",
  "apis": [
    {
      "path": "/api/user_activities.json",
      "operations": [
        {
          "parameters": [
            {
              "paramType": "query",
              "name": "access_token",
              "type": "string",
              "description": "Access token",
              "required": true
            },
            {
              "paramType": "query",
              "name": "customer_group_uuid",
              "type": "string",
              "description": "UUID of Customer Group [empty = all]",
              "required": false
            },
            {
              "paramType": "query",
              "name": "usage_type",
              "type": "string",
              "description": "Usage Type [dashboard, mobile, calendar; empty = all]",
              "required": false
            },
            {
              "paramType": "query",
              "name": "action_type",
              "type": "string",
              "description": "Action Type [view, change, login, all; empty/default = change]",
              "required": false
            },
            {
              "paramType": "query",
              "name": "from",
              "type": "integer",
              "description": "Starting epoch timestamp in seconds [empty starts at 0, default is empty/0]",
              "required": false
            },
            {
              "paramType": "query",
              "name": "to",
              "type": "integer",
              "description": "Ending epoch timestamp in seconds. Default value is current time.",
              "required": false,
              "defaultValue": 1785278041
            },
            {
              "paramType": "query",
              "name": "order",
              "type": "string",
              "description": "Order of activities returned [asc is default, desc is required to return most recent activities]",
              "required": false,
              "defaultValue": "asc"
            },
            {
              "paramType": "query",
              "name": "limit",
              "type": "integer",
              "description": "Number of activities to return [1 is minimum, 100 is default, 1200 is maximum]",
              "required": false,
              "defaultValue": 100
            }
          ],
          "summary": "Get all user activities for your customer(s)",
          "responseMessages": [
            {
              "code": 200,
              "responseModel": null,
              "message": "Success"
            },
            {
              "code": 401,
              "responseModel": null,
              "message": "Not Authorized"
            },
            {
              "code": 404,
              "responseModel": null,
              "message": "Not Found"
            }
          ],
          "nickname": "Api::UserActivities#index",
          "method": "get"
        }
      ]
    }
  ],
  "authorizations": null
}