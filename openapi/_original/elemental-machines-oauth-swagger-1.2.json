{
  "apiVersion": "1.0",
  "swaggerVersion": "1.2",
  "resourcePath": "oauth",
  "apis": [
    {
      "path": "/oauth/token",
      "operations": [
        {
          "parameters": [
            {
              "paramType": "form",
              "name": "username",
              "type": "string",
              "description": "Email address",
              "required": true
            },
            {
              "paramType": "form",
              "name": "password",
              "type": "string",
              "format": "password",
              "description": "Password",
              "required": true
            },
            {
              "paramType": "form",
              "name": "client_id",
              "type": "string",
              "description": "Client ID",
              "required": true
            },
            {
              "paramType": "form",
              "name": "client_secret",
              "type": "string",
              "description": "Client secret",
              "required": true
            },
            {
              "paramType": "query",
              "name": "grant_type",
              "type": "string",
              "description": "Grant type",
              "defaultValue": "password"
            }
          ],
          "summary": "Get access token",
          "notes": "An access token is needed for all subsequent authenticated requests. Contact us for Client ID/Secret.",
          "responseMessages": [
            {
              "code": 200,
              "responseModel": null,
              "message": "Success"
            },
            {
              "code": 401,
              "responseModel": null,
              "message": "Unauthorized"
            }
          ],
          "nickname": "token",
          "method": "post"
        }
      ]
    }
  ],
  "authorizations": null
}
